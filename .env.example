# Overpass endpoints for `pnpm data`, tried in turn when one is overloaded. When all of
# them fail, the build falls back to the main OpenStreetMap API.
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://overpass.private.coffee/api/interpreter
LOG_LEVEL=info
# For `pnpm translate` only. Keys from the free DeepL plan end in ":fx".
DEEPL_API_KEY=
