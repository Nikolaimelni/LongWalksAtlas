{
	"name": "long-walks-atlas",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.34.6",
	"engines": {
		"node": "^24"
	},
	"scripts": {
		"dev": "node scripts/build-content.ts && react-router dev",
		"build": "node scripts/build-content.ts && react-router build && node scripts/add-404-page.ts && node scripts/add-csp.ts",
		"preview": "node scripts/serve-static.ts",
		"typecheck": "node scripts/build-content.ts && react-router typegen && tsc",
		"content": "node scripts/build-content.ts",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "node scripts/build-content.ts && vitest run",
		"test:watch": "vitest",
		"e2e": "playwright test",
		"data": "node --env-file-if-exists=.env scripts/build-data.ts",
		"photos": "node scripts/build-photos.ts",
		"icons": "node scripts/build-icons.ts",
		"translate": "node --env-file-if-exists=.env scripts/translate.ts",
		"build:deploy": "pnpm build && node scripts/build-og.ts"
	},
	"dependencies": {
		"@fontsource-variable/noto-sans": "^5.3.0",
		"@fontsource-variable/noto-serif": "^5.3.0",
		"fuse.js": "^7.5.0",
		"i18next": "^26.5.2",
		"maplibre-gl": "^6.15.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"react-i18next": "^17.1.0",
		"react-map-gl": "^8.1.3",
		"react-router": "^8.4.0",
		"zod": "^4.6.7",
		"isbot": "^5.2.2"
	},
	"devDependencies": {
		"@babel/core": "^8.0.7",
		"@biomejs/biome": "^2.5.15",
		"@playwright/test": "^1.64.1",
		"@react-router/dev": "^8.4.0",
		"@rolldown/plugin-babel": "^0.2.4",
		"@tailwindcss/vite": "^4.3.3",
		"@turf/bbox": "^7.4.0",
		"@turf/length": "^7.4.0",
		"@turf/simplify": "^7.4.0",
		"@types/geojson": "^7946.0.16",
		"@types/node": "^24.19.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"babel-plugin-react-compiler": "^1.0.0",
		"marked": "^18.1.1",
		"parse5": "^8.0.1",
		"pino": "^10.4.0",
		"pino-pretty": "^13.2.0",
		"sharp": "^0.35.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^8.3.4",
		"vitest": "^5.0.5",
		"yaml": "^2.9.1"
	}
}
