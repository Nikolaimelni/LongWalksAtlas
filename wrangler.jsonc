// A Worker with static assets only: every page is prerendered, so there is no server
// code to run. The deploy job in .github/workflows/ci.yml builds it and runs wrangler.
{
	"name": "long-walks-atlas",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./build/client",
		// /en becomes /en/, which is where each prerendered index.html lives.
		"html_handling": "auto-trailing-slash",
		// The nearest 404.html with a real 404, the way scripts/serve-static.ts does it.
		"not_found_handling": "404-page"
	},
	"routes": [{ "pattern": "longwalksatlas.com", "custom_domain": true }]
}
